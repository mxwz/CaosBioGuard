# 复制为 .env 后修改；不要提交真实 .env。
# Web 端口和绑定地址。默认仅绑定本机，需要局域网访问可设 0.0.0.0。
WEB_PORT=6100
WEB_BIND_ADDRESS=127.0.0.1

# MySQL：容器内部访问，默认不发布 3306。
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=caos_bioguard
MYSQL_USER=caos
MYSQL_PASSWORD=replace-with-strong-app-password

# 应用密钥。
CAOS_FLASK_SECRET_KEY=replace-with-long-random-secret
CAOS_SYNC_TOKEN=replace-with-long-sync-token
CAOS_AGENT_TOKEN=replace-with-long-agent-token
CAOS_HMAC_SECRET=replace-with-long-hmac-secret

# Fernet key，生成方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAOS_ENCRYPTION_KEY=replace-with-fernet-key
