FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    QT_QPA_PLATFORM=xcb \
    TZ=Asia/Shanghai

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libegl1 libglib2.0-0 libgomp1 \
    libxkbcommon-x11-0 libxcb-cursor0 libxcb-xinerama0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-shape0 \
    libxrender1 libsm6 libfontconfig1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/requirements-edge.txt requirements/requirements-edge.txt
RUN pip install --no-cache-dir -r requirements/requirements-edge.txt

COPY . .
RUN mkdir -p sideUI/dd sideUI/face_images

CMD ["python", "-m", "sideUI.kiosk.app"]
