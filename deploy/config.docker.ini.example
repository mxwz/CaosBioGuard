; Caos BioGuard Docker / 新部署示例配置
; 复制为 config.ini 后修改；真实密钥优先使用环境变量，不要提交真实密钥。
[General]
mode=standalone
; offline/online；离线时本地识别并写入 outbox，恢复网络后同步
networkmode=offline
startmode=manual
syncinterval=30
configupdatedat=

[Cloud]
; 单机/边缘默认 false；要让 Web 使用 MySQL+R2 改为 true，并配置 [MySQL]/[S3]
enabled=false
host=
user=
password=
database=
lastenabled=false

[Deployment]
; operation_mode: offline/online；network_scope: lan/public；topology: integrated/separated
operation_mode=offline
network_scope=lan
topology=integrated
public_base_url=

[BiometricBackends]
; auto=优先可用 SDK 并允许模型回退；model=强制模型；sdk=强制 SDK；fusion=双后端融合
default_policy=auto
allow_fallback=true

[S3]
endpoint=
access_key=
secret_key=
bucket=
region=auto

[MySQL]
host=mysql
user=caos
password=
database=caos_bioguard
port=3306

[Security]
; Fernet key；也可通过 CAOS_ENCRYPTION_KEY 注入。生产环境留空且未配置环境变量时拒绝写入。
encryptionkey=
flask_secret_key=

[WebAdmin]
host=0.0.0.0
port=6100
protocol=http
; 手机端/小程序/Agent 调 API 用；也可通过环境变量注入，生产环境必须替换。
token=
salt=
; 逗号分隔跨域白名单，例如 https://guard.example.com；空表示仅同源
cors_origins=

[Templates]
company=
community=

[Enums]
gender=男,女,未知
status=正常,迟到,早退,旷工,请假
access_level=员工,访客,管理员
property_type=住宅,商铺,办公
resident_type=业主,租户,家属
access_areas=大门,楼栋,电梯,停车场

[UI]
theme=obsidian

[Kiosk]
camera_index=0
fullscreen=true
threshold=0.45
liveness_mode=strict
liveness_threshold=0.72
cooldown=3
device_id=edge-001
company=Caos BioGuard
admin_pin=

[Sync]
endpoint=
secret=
device_id=edge-001
batch_size=20
max_attempts=8
base_delay=2
timeout=8

[Hardware]
enabled=true
; simulator=无硬件联调，serial=串口/USB 继电器
mode=simulator
serial_port=COM3
baudrate=9600
open_command=A0 01 01 A2
close_command=A0 01 00 A1
unlock_duration=3
alarm_duration=30
reader_protocol=wiegand26
lock_name=door-lock

; 厂商 SDK 默认关闭；接入真实设备时 enabled=true，并按 SDK 包装方式填写
[VendorSDK.face]
enabled=false
vendor=baidu
mode=ctypes
wrapper_library=vendor_wrappers/caos_bdface.dll
license_path=
model_path=
sdk_version=8.4

[VendorSDK.fingerprint]
enabled=false
vendor=example
mode=python
python_class=vendor_adapters.FingerprintAdapter
template_format=iso19794-2
sdk_version=1.0

[VendorSDK.iris]
enabled=false
vendor=example
mode=python
python_class=vendor_adapters.IrisAdapter
template_format=iso19794-6
sdk_version=1.0

[VendorSDK.palmprint]
enabled=false
vendor=example
mode=python
python_class=vendor_adapters.PalmprintAdapter
template_format=vendor
sdk_version=1.0

[VendorSDK.vein]
enabled=false
vendor=example
mode=python
python_class=vendor_adapters.VeinAdapter
template_format=vendor
sdk_version=1.0

[VendorSDK.retina]
enabled=false
vendor=example
mode=python
python_class=vendor_adapters.RetinaAdapter
template_format=vendor
sdk_version=1.0
; command 模式示例：mode=command，command=C:/sdk/caos_sdk_wrapper.exe，args=--device finger-01
