; Caos BioGuard Docker / 新部署示例配置
; 复制为 config.ini 后修改；不要提交真实密钥。
[General]
mode=standalone
; offline/online；离线时本地识别并写入 outbox，恢复网络后同步
networkmode=offline
startmode=manual
syncinterval=30
configupdatedat=

[Cloud]
; 单机/边缘默认 false；要让 Web 使用 MySQL+R2 改为 true，并配置 [MySQL]/[S3]
enabled=false
host=
user=
password=
database=
lastenabled=false

[Deployment]
; operation_mode: offline/online；network_scope: lan/public；topology: integrated/separated
operation_mode=offline
network_scope=lan
topology=integrated
public_base_url=

[S3]
endpoint=
access_key=
secret_key=
bucket=
region=auto

[MySQL]
host=mysql
user=caos
password=caos_pwd
database=caos_bioguard
port=3306

[Security]
; 32 字节 urlsafe base64 的 Fernet key；留空会退化为明文并告警
encryptionkey=

[WebAdmin]
host=0.0.0.0
port=5000
protocol=http
; 手机端/小程序/Agent 调 API 用；生产务必替换
token=change-me-to-a-long-random-token
salt=change-me-salt
; 逗号分隔跨域白名单，例如 https://guard.example.com；空表示仅同源
cors_origins=

[Templates]
company=
community=

[Enums]
gender=男,女,未知
status=正常,迟到,早退,旷工,请假
access_level=员工,访客,管理员
property_type=住宅,商铺,办公
resident_type=业主,租户,家属
access_areas=大门,楼栋,电梯,停车场

[UI]
theme=obsidian

[Kiosk]
camera_index=0
fullscreen=true
threshold=0.45
liveness_mode=degraded
liveness_threshold=0.55
cooldown=3
device_id=edge-001
company=Caos BioGuard
admin_pin=123456

[Sync]
endpoint=
secret=
device_id=edge-001
batch_size=20
max_attempts=8
base_delay=2
timeout=8

[Hardware]
enabled=true
; simulator=无硬件联调，serial=串口/USB 继电器
mode=simulator
serial_port=COM3
baudrate=9600
open_command=A0 01 01 A2
close_command=A0 01 00 A1
unlock_duration=3
alarm_duration=30
reader_protocol=wiegand26
lock_name=door-lock
